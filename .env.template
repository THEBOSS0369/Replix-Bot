# ===========================================
# AI Provider API Keys
# ===========================================
# Configure provider in: src/config/ai.config.ts

# Google Gemini
VITE_GEMINI_API_KEY=your-gemini-api-key

# OpenAI
VITE_OPENAI_API_KEY=your-openai-api-key

# Anthropic Claude
VITE_ANTHROPIC_API_KEY=your-claude-api-key

# ===========================================
# Database Configuration
# ===========================================
# Configure provider in: src/config/database.config.ts

# Supabase (only needed if using Supabase provider)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Local PostgreSQL settings are in src/config/database.config.ts
# Default: localhost:5432, database: repllix, user: postgres, password: postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=repllix
DB_USER=
DB_PASSWORD=
API_PORT=3001